{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shega",
	"compatibility_date": "2026-10-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".open-next/worker.js",
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"account_id": "eb52ca1df76d657794f3779458cba062",
	"d1_databases": [
		{
			"binding": "CONTENT_DB",
			"database_name": "shega-events-content",
			"database_id": "15a2e1c5-264c-4f54-957e-6bcea8422fb2",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "shega-events-media",
			"binding": "MEDIA"
		}
	]
}